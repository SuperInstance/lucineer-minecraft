{
  "comment": "Lucineer STEM Platform - Complete Minecraft Mod Design",
  "version": "1.0.0",
  "minecraft_version": "1.21.1",
  "loader": "neoforge",
  
  "overview": {
    "name": "Lucineer: Chip Design STEM Studio",
    "tagline": "Learn Electronics, Chip Design, and AI Through Minecraft",
    "target_audience": "Ages 5+ to Professional",
    "core_concept": "Gamified STEM learning through hands-on chip design, thermal simulation, and neural network building"
  },
  
  "learning_philosophy": {
    "progressive_revelation": "Concepts unlock as players explore and discover",
    "age_adaptive": "Content adapts to player level (elementary/middle/high/professional)",
    "hands_on": "Build real circuits, see thermal effects, train neural networks",
    "character_driven": "NPCs like Volt, Bit, Fetch guide learning",
    "infinite_progression": "Endless lessons generated by AI based on interests"
  },
  
  "core_systems": {
    "voxel_chip_explorer": {
      "description": "Stephen Biesty-inspired cross-section explorer for electronics",
      "minecraft_integration": {
        "block": "lucineer:chip_block",
        "interaction": "Right-click with Magnifying Glass to enter cross-section view",
        "visualization": "Shrink player to see internal chip structure in voxels"
      },
      "teaching_modules": {
        "transistor": {
          "unlocks_at": "Age 10+ or Redstone Expert",
          "components": ["source", "drain", "gate", "channel", "oxide"],
          "interactive_elements": [
            "Click gate to toggle electron flow",
            "See doping concentration with color",
            "Watch electron flow animation"
          ],
          "redstone_analogy": "Gate input controls output like redstone repeater"
        },
        "cpu_core": {
          "unlocks_at": "Age 12+ or Logic Master",
          "components": ["alu", "register_file", "cache", "interconnects", "clock"],
          "interactive_elements": [
            "Watch instructions flow through pipeline",
            "See cache hits/misses with particles",
            "Follow a bit through the execution path"
          ],
          "redstone_analogy": "Like a complex redstone computer"
        },
        "memory_cell": {
          "unlocks_at": "Age 8+",
          "components": ["capacitor", "transistor", "bitline", "wordline"],
          "interactive_elements": [
            "Charge/discharge capacitor animation",
            "See refresh cycles",
            "Watch read/write operations"
          ]
        },
        "led_junction": {
          "unlocks_at": "Age 5+ (Starter)",
          "components": ["p_region", "n_region", "junction", "photons"],
          "interactive_elements": [
            "See electrons recombine",
            "Watch photon emission particles",
            "Color change with material selection"
          ]
        }
      },
      "characters": [
        {"id": "volt", "name": "Volt", "emoji": "⚡", "teaches": "Electrical potential and voltage"},
        {"id": "bit", "name": "Bit", "emoji": "📦", "teaches": "Binary and data representation"},
        {"id": "fetch", "name": "Fetch", "emoji": "🐕", "teaches": "CPU fetch-decode-execute"},
        {"id": "cache", "name": "Cache", "emoji": "🐿️", "teaches": "Memory hierarchy"},
        {"id": "switch", "name": "Switch", "emoji": "🚪", "teaches": "Transistor switching"}
      ]
    },
    
    "rtl_design_studio": {
      "description": "Progressive chip design workflow from concept to silicon",
      "minecraft_integration": {
        "structure": "lucineer:design_studio",
        "crafting": "RTL Workbench + Schematic Table + Fabrication Chamber",
        "multiplayer": "Collaborative chip design"
      },
      "design_stages": {
        "rtl_design": {
          "stage": 1,
          "activity": "Write Verilog-like commands in books",
          "output": "Logic Gate Blueprint",
          "xp_reward": 100,
          "redstone_equivalent": "Design redstone circuit in logic table"
        },
        "synthesis": {
          "stage": 2,
          "activity": "Convert RTL to gate netlist",
          "output": "Gate List",
          "xp_reward": 150,
          "redstone_equivalent": "Optimize redstone with equivalent circuits"
        },
        "floorplanning": {
          "stage": 3,
          "activity": "Arrange blocks in chip area",
          "output": "Floorplan Map",
          "xp_reward": 200,
          "redstone_equivalent": "Plan redstone layout in build area"
        },
        "placement": {
          "stage": 4,
          "activity": "Place standard cells in grid",
          "output": "Placed Design",
          "xp_reward": 200,
          "redstone_equivalent": "Place repeaters and comparators"
        },
        "cts": {
          "stage": 5,
          "activity": "Build clock distribution network",
          "output": "Balanced Clock Tree",
          "xp_reward": 250,
          "redstone_equivalent": "Design redstone clock with equal delays"
        },
        "routing": {
          "stage": 6,
          "activity": "Connect signals through metal layers",
          "output": "Routed Chip",
          "xp_reward": 250,
          "redstone_equivalent": "Wire redstone signals without crossing"
        },
        "timing_signoff": {
          "stage": 7,
          "activity": "Verify timing constraints",
          "output": "Timing Report",
          "xp_reward": 300,
          "redstone_equivalent": "Test redstone timing with repeaters"
        },
        "physical_verification": {
          "stage": 8,
          "activity": "Check design rules",
          "output": "Clean DRC/LVS Report",
          "xp_reward": 300,
          "redstone_equivalent": "Verify redstone doesn't have gaps"
        },
        "tapeout": {
          "stage": 9,
          "activity": "Manufacture chip",
          "output": "Fabricated Chip Item",
          "xp_reward": 500,
          "redstone_equivalent": "Finalize and freeze design"
        }
      }
    },
    
    "thermal_simulation": {
      "description": "Real-time thermal simulation of chip designs",
      "minecraft_integration": {
        "visual_feedback": "Heat map overlay on chip blocks",
        "materials": "Blocks have thermal properties (conductivity, specific heat)",
        "cooling": "Water, ice, and special cooling blocks",
        "failure": "Overheating causes chip to fail"
      },
      "physics": {
        "heat_equation": "∂T/∂t = α∇²T + Q/(ρc)",
        "thermal_resistance": "R_th = L / (k × A)",
        "time_constant": "τ = L² / (π²α)"
      },
      "materials_database": {
        "silicon_block": {
          "thermal_conductivity": 148.0,
