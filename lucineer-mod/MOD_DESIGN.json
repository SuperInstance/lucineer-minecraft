          "tier": "advanced"
        },
        "sio2_insulator": {
          "thermal_conductivity": 1.4,
          "specific_heat": 745.0,
          "color": "#E2E8F0",
          "tier": "basic"
        }
      },
      "heat_sources": {
        "mac_unit": {
          "power_density": "0.5 W/mm²",
          "activity_dependent": true
        },
        "memory_array": {
          "power_density": "0.1 W/mm²",
          "activity_dependent": true
        },
        "clock_network": {
          "power_density": "0.3 W/mm²",
          "activity_dependent": false
        }
      },
      "gameplay_mechanics": {
        "thermal_monitor": "Right-click to see temperature map",
        "cooling_challenge": "Keep chip under 85°C during operation",
        "hot_spot_alert": "Particles indicate overheating areas",
        "thermal_runaway": "Chain reaction if cooling fails"
      }
    },
    
    "neural_cell_builder": {
      "description": "Build neural networks using spreadsheet-like cells",
      "minecraft_integration": {
        "container": "Neural Network Grid (9x9 chest-like)",
        "cells": "Items represent different cell types",
        "connections": "Redstone dust connects cells",
        "training": "Feed data items to train network"
      },
      "cell_types": {
        "input_cell": {
          "item": "lucineer:input_cell",
          "function": "Receives input data",
          "recipe": "Redstone + Paper"
        },
        "neuron_cell": {
          "item": "lucineer:neuron_cell",
          "function": "Computes weighted sum + activation",
          "recipe": "Redstone Comparator + Copper + Gold Nugget"
        },
        "weight_item": {
          "item": "lucineer:weight_item",
          "function": "Adjustable weight value (right-click to tune)",
          "recipe": "Iron Nugget + Dye (color = sign)"
        },
        "activation_cell": {
          "item": "lucineer:activation_cell",
          "function": "ReLU, Sigmoid, or Tanh",
          "recipe": "Redstone Torch + Emerald"
        },
        "output_cell": {
          "item": "lucineer:output_cell",
          "function": "Produces classification output",
          "recipe": "Redstone Lamp + Diamond"
        }
      },
      "operations": {
        "forward_pass": "Watch items flow through network",
        "backprop": "Error particles flow backward",
        "weight_update": "Weights change color as they train"
      }
    },
    
    "progressive_learning": {
      "description": "Infinite lesson generation based on player interests",
      "curriculum_tiers": {
