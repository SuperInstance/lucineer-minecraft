        {
          "name": "Reaction Temperature",
          "value": "T = 1900°C",
          "meaning": "Carbothermic reduction"
        },
        {
          "name": "Chemical Equation",
          "value": "SiO₂ + 2C → Si + 2CO",
          "meaning": "Silicon dioxide to silicon"
        }
      ],
      "game_mechanic": {
        "input": "minecraft:sand",
        "fuel": "minecraft:charcoal",
