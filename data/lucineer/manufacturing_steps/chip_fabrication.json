      "subtitle": "Neural Encoding",
      "block": "lucineer:ternary_weight_block",
      "physics": [
        {
          "name": "Ternary Encoding",
          "value": "w ∈ {-1, 0, +1}",
          "meaning": "BitNet weights"
        },
        {
          "name": "Zero Access Energy",
          "value": "E_access = 0",
          "meaning": "No memory fetch"
        }
      ],
      "game_mechanic": {
        "input": "lucineer:neural_network_design",
        "encoding": "ternary",
        "output": "lucineer:mask_locked_chip"
      },
      "voxel_concept": "Freeze the weights! See neural patterns become silicon reality"
    },
    {
      "id": "packaging",
      "name": "Packaging",
      "subtitle": "Chip Protection",
      "block": "lucineer:packaged_chip",
      "physics": [
        {
          "name": "Thermal Resistance",
          "value": "θ_ja = 20-100 °C/W",
          "meaning": "Heat dissipation"
        },
        {
          "name": "Bond Wire",
          "value": "d = 25-50 μm",
          "meaning": "Wire diameter"
        }
