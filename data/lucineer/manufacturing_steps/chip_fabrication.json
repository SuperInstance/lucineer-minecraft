        "output": "lucineer:raw_silicon",
        "time_ticks": 1200
      },
      "voxel_concept": "Watch sand grains transform into glowing crystals"
    },
    {
      "id": "czochralski_growth",
      "name": "Czochralski Growth",
      "subtitle": "Crystal Pulling",
