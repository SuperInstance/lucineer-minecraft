    {
      "id": "testing_binning",
      "name": "Testing & Binning",
      "subtitle": "Quality Sorting",
      "block": "lucineer:tested_chip",
      "physics": [
        {
          "name": "Test Coverage",
          "value": "C > 99%",
          "meaning": "Fault detection"
        },
        {
          "name": "Yield",
          "value": "Y = e^(-D₀A)",
          "meaning": "Poisson model"
