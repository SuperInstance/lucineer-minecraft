{
  "comment": "STEM Project Component - Data Component for crafting real engineering projects",
  "schema_version": "1.21.1",
  "loader": "neoforge:data_component_type",
  
  "name": "lucineer:stem_project",
  "persistent": true,
  "network_synced": true,
  
  "schema": {
    "type": "object",
    "properties": {
      "project_id": {
        "type": "string",
        "description": "Unique project identifier"
      },
      "project_type": {
        "type": "string",
        "enum": [
          "chip_design",
          "neural_network",
          "thermal_analysis",
          "circuit_design",
          "transistor_model",
          "mac_array",
          "memory_cell",
          "interconnect"
        ],
        "description": "Type of STEM project"
      },
      "difficulty_tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "Learning tier (1=beginner, 10=master)"
      },
      "components": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "component_id": { "type": "string" },
            "component_type": { "type": "string" },
            "quantity": { "type": "integer" },
            "position": {
              "type": "object",
              "properties": {
                "x": { "type": "integer" },
                "y": { "type": "integer" },
                "z": { "type": "integer" }
              }
            }
          }
        },
        "description": "Components required for this project"
      },
      "learning_outcomes": {
        "type": "array",
        "items": { "type": "string" },
        "description": "What the player will learn"
      },
      "validation_criteria": {
        "type": "object",
        "properties": {
          "thermal_threshold_k": { "type": "number" },
          "power_budget_w": { "type": "number" },
          "accuracy_requirement": { "type": "number" },
          "timing_ns": { "type": "number" }
        }
      },
      "progress": {
        "type": "object",
        "properties": {
          "completed_steps": { "type": "integer" },
          "total_steps": { "type": "integer" },
          "validation_passed": { "type": "boolean" },
          "best_score": { "type": "number" }
        }
      },
      "generated_by": {
        "type": "object",
        "properties": {
          "model": { "type": "string" },
          "provider": { "type": "string" },
          "seed": { "type": "integer" }
        }
      }
    },
    "required": ["project_id", "project_type", "difficulty_tier"]
  },
  
  "project_presets": {
    "simple_led_circuit": {
      "project_type": "circuit_design",
      "difficulty_tier": 1,
      "learning_outcomes": [
        "Understand voltage and current",
        "Learn about LED polarity",
        "Calculate resistor values"
      ],
      "validation_criteria": {
        "thermal_threshold_k": 350,
        "power_budget_w": 0.5
      }
    },
    "transistor_switch": {
      "project_type": "transistor_model",
      "difficulty_tier": 2,
      "learning_outcomes": [
        "MOSFET operation principles",
        "Gate voltage control",
        "Switching characteristics"
      ]
    },
    "neuron_cell": {
      "project_type": "neural_network",
      "difficulty_tier": 3,
      "learning_outcomes": [
        "Neuron activation functions",
        "Weight calculations",
        "Forward propagation"
      ]
    },
    "ternary_mac": {
      "project_type": "mac_array",
      "difficulty_tier": 5,
      "learning_outcomes": [
        "Ternary weight encoding",
        "BitNet architecture",
        "Energy-efficient computation"
      ]
    },
    "full_chip_design": {
      "project_type": "chip_design",
      "difficulty_tier": 7,
      "learning_outcomes": [
        "Complete RTL-to-GDSII flow",
        "Thermal management",
        "Yield optimization"
      ]
    }
  }
}
