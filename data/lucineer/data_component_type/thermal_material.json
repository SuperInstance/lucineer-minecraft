        "maximum": 25000.0,
        "description": "Material density in kg/m³"
      },
      "thermal_diffusivity_m2_s": {
        "type": "number",
        "description": "Calculated: k / (ρ * cp)"
      },
      "melting_point_k": {
        "type": "number",
        "minimum": 0,
        "description": "Melting temperature in Kelvin"
      },
      "electrical_conductivity_s_m": {
        "type": "number",
        "description": "Electrical conductivity in S/m"
      }
    },
    "required": ["material_id", "name", "category", "thermal_conductivity_w_mk", "specific_heat_j_kgk", "density_kg_m3"]
