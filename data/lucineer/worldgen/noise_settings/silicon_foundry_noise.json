{
  "comment": "Silicon Foundry Noise Settings - Based on thermal grid simulation",
  "schema_version": "1.21.1",
  
  "name": "lucineer:silicon_foundry_noise",
  
  "sea_level": -60,
  "disable_mob_generation": true,
  "aquifers_enabled": false,
  "ore_veins_enabled": false,
  "legacy_random_source": false,
  
  "default_block": {
    "Name": "minecraft:iron_block",
    "Properties": {}
  },
  "default_fluid": {
    "Name": "minecraft:air",
    "Properties": {}
  },
  
  "noise": {
    "min_y": -64,
    "height": 384,
    "size_horizontal": 1,
    "size_vertical": 2,
    "sampling": {
      "xz_scale": 1.0,
      "y_scale": 1.0,
      "xz_factor": 80.0,
      "y_factor": 160.0
    },
    "bottom_slide": {
      "target": -30,
      "size": 0,
      "input": 0
    },
    "top_slide": {
      "target": -30,
      "size": 0,
      "input": 0
    },
    "terrain_shaper": {
      "offset": 0.0,
      "factor": 0.0,
      "jaggedness": 0.0
    },
    "initial_density_without_jaggedness": {
      "type": "minecraft:flat_cache",
      "argument": {
        "type": "minecraft:cache_2d",
        "argument": {
          "type": "minecraft:noise",
          "noise": "minecraft:aquifer_fluid_pick",
          "xz_scale": 1.0,
          "y_scale": 0.67
        }
      }
    },
    "final_density": {
      "type": "minecraft:squeeze",
      "argument": {
        "type": "minecraft:interpolated",
        "argument": {
          "type": "minecraft:flat_cache",
          "argument": {
            "type": "minecraft:cache_2d",
            "argument": {
              "type": "minecraft:noise",
              "noise": "minecraft:aquifer_fluid_pick",
              "xz_scale": 1.0,
              "y_scale": 0.67
            }
          }
        }
      }
    },
    "temperature": {},
    "vegetation": {},
    "continents": {},
    "erosion": {},
    "depth": {},
    "ridges": {}
  },
  
  "noise_router": {
    "barrier": 0,
    "fluid_level_floodedness": 0,
    "fluid_level_spread": 0,
    "lava": 0,
    "temperature": {
      "type": "minecraft:shifted_noise",
      "noise": "minecraft:temperature",
      "xz_scale": 0.25,
      "y_scale": 0,
      "shift_x": "minecraft:shift_x",
      "shift_z": "minecraft:shift_z"
    },
    "vegetation": 0,
    "continents": 0,
    "erosion": 0,
    "depth": 0,
    "ridges": 0,
    "initial_density_without_jaggedness": 0,
    "final_density": 0,
    "vein_toggle": 0,
    "vein_ridged": 0,
    "vein_gap": 0
  },
  
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequences": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 0,
          "surface_type": "floor",
          "add_surface_depth": false,
          "secondary_depth_range": 0
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:copper_block"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 0,
          "surface_type": "under_floor",
          "add_surface_depth": true,
          "secondary_depth_range": 0
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:iron_block"
          }
        }
      }
    ]
  },
  
  "lucineer:thermal_grid": {
    "grid_type": "finite_difference",
    "boundary_left": "neumann",
    "boundary_right": "neumann",
    "boundary_top": "convective",
    "boundary_bottom": "dirichlet",
    "convection_coefficient_w_m2k": 100000.0,
    "ambient_temperature_k": 300.0,
    "thermal_conductivity_w_mk": 148.0,
    "heat_source_config": {
      "type": "distributed",
      "pattern": "gaussian",
      "sigma": 2.0
    }
  }
}
