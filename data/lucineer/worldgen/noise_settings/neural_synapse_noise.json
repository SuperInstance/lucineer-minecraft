{
  "comment": "Neural Synapse Noise Settings - Organic network topology",
  "schema_version": "1.21.1",
  
  "name": "lucineer:neural_synapse_noise",
  
  "sea_level": 32,
  "disable_mob_generation": false,
  "aquifers_enabled": false,
  "ore_veins_enabled": false,
  "legacy_random_source": false,
  
  "default_block": {
    "Name": "minecraft:netherrack"
  },
  "default_fluid": {
    "Name": "minecraft:lava",
    "Properties": {
      "level": "0"
    }
  },
  
  "noise": {
    "min_y": 0,
    "height": 256,
    "size_horizontal": 2,
    "size_vertical": 1,
    "sampling": {
      "xz_scale": 1.0,
      "y_scale": 2.0,
      "xz_factor": 80.0,
      "y_factor": 60.0
    },
    "bottom_slide": {
      "target": 0.1171875,
      "size": 3,
      "input": -1
    },
    "top_slide": {
      "target": -0.078125,
      "size": 2,
      "input": -1
    },
    "terrain_shaper": {
      "offset": 0.2222,
      "factor": 5.0,
      "jaggedness": 0.0
    },
    "initial_density_without_jaggedness": {
      "type": "minecraft:flat_cache",
      "argument": {
        "type": "minecraft:cache_2d",
        "argument": {
          "type": "minecraft:noise",
          "noise": "minecraft:nether_state",
          "xz_scale": 1.0,
          "y_scale": 2.0
        }
      }
    },
    "final_density": {
      "type": "minecraft:squeeze",
      "argument": {
        "type": "minecraft:interpolated",
        "argument": {
          "type": "minecraft:flat_cache",
          "argument": {
            "type": "minecraft:cache_2d",
            "argument": {
              "type": "minecraft:noise",
              "noise": "minecraft:nether_state",
              "xz_scale": 1.0,
              "y_scale": 2.0
            }
          }
        }
      }
    },
    "temperature": {},
    "vegetation": {},
    "continents": {},
    "erosion": {},
    "depth": {},
    "ridges": {}
  },
  
  "noise_router": {
    "barrier": 0,
    "fluid_level_floodedness": 0,
    "fluid_level_spread": 0,
    "lava": {
      "type": "minecraft:shifted_noise",
      "noise": "minecraft:nether/lava",
      "xz_scale": 1.0,
      "y_scale": 1.0,
      "shift_x": "minecraft:shift_x",
      "shift_z": "minecraft:shift_z"
    },
    "temperature": 0,
    "vegetation": 0,
    "continents": 0,
    "erosion": 0,
    "depth": 0,
    "ridges": 0,
    "initial_density_without_jaggedness": 0,
    "final_density": 0,
    "vein_toggle": 0,
    "vein_ridged": 0,
    "vein_gap": 0
  },
  
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequences": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "minecraft:bedrock_floor",
          "true_at_and_below": {
            "above_bottom": 0
          },
          "false_at_and_above": {
            "above_bottom": 5
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:bedrock"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 0,
          "surface_type": "floor",
          "add_surface_depth": false,
          "secondary_depth_range": 0
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:glowstone"
          }
        }
      }
    ]
  },
  
  "lucineer:neural_network": {
    "synapse_pattern": "stochastic",
    "connection_density": 0.15,
    "weight_distribution": {
      "type": "ternary",
      "values": [-1, 0, 1],
      "probabilities": [0.25, 0.5, 0.25]
    },
    "plasticity_enabled": true,
    "thermal_coupling": {
      "activity_heat_w": 0.0001,
      "cooling_rate_k_s": 0.01
    }
  }
}
