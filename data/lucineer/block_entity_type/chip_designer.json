{
  "comment": "Chip Designer Block Entity - Thermal simulation interface",
  "schema_version": "1.21.1",
  "loader": "neoforge:block_entity_type",
  
  "name": "lucineer:chip_designer",
  "block": "lucineer:chip_designer_block",
  
  "gui": {
    "width": 320,
    "height": 240,
    "title": "Chip Designer"
  },
  
  "chip_variants": {
    "LUCI-1": {
      "parameters": "1B",
      "power_watts": 2.0,
      "tokens_per_second": 15,
      "process_node_nm": 28,
      "grid_size": { "nx": 32, "ny": 32, "nz": 1 }
    },
    "LUCI-3": {
      "parameters": "3B",
      "power_watts": 5.0,
      "tokens_per_second": 25,
      "process_node_nm": 28,
      "grid_size": { "nx": 64, "ny": 64, "nz": 1 }
    },
    "LUCI-7": {
      "parameters": "7B",
      "power_watts": 10.0,
      "tokens_per_second": 35,
      "process_node_nm": 28,
      "grid_size": { "nx": 128, "ny": 128, "nz": 1 }
    },
    "CUSTOM": {
      "parameters": "variable",
      "power_watts": "variable",
      "grid_size": "custom"
    }
  },
  
  "simulation_config": {
    "default_material": "silicon",
    "convergence_tolerance": 1.0e-5,
    "max_iterations": 10000,
    "boundary_top": "convective",
    "boundary_bottom": "dirichlet",
    "boundary_sides": "neumann",
    "convection_coefficient_w_m2k": 100000.0,
    "ambient_temperature_k": 300.0
  },
  
  "heat_source_placement": {
    "types": ["point", "gaussian", "uniform", "rectangular"],
    "max_sources": 100,
    "power_range_w": [1e-9, 1e-3],
    "default_shape": "gaussian",
    "default_sigma": 2.0
  },
  
  "visualization": {
    "colormap": {
      "cold_k": 300,
      "cold_color": "#4444FF",
      "hot_k": 400,
      "hot_color": "#FF4444"
    },
    "update_interval_ticks": 20,
    "show_heat_flow_arrows": true,
    "show_isotherms": true
  },
  
  "output": {
    "thermal_map": "temperature array",
    "gradient_map": "thermal gradient vectors",
    "statistics": ["max_temp", "min_temp", "avg_temp", "hot_spots"]
  }
}
